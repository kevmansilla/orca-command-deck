{
  "manifestVersion": 2,
  "id": "command-deck",
  "name": "Command Deck",
  "version": "0.4.0",
  "description": "Tus agentes, bots y repos en un solo panel: quién te espera, quién trabaja, y el Source Control de todos los repos de Orca.",
  "engines": {
    "orca": ">=1.4.259"
  },
  "execution": "trusted-worker",
  "pluginApi": 1,
  "main": "main.mjs",
  "contributes": {
    "panels": [
      {
        "id": "command-deck",
        "title": "Command Deck",
        "icon": "layers",
        "entry": "index.html",
        "ui": "html"
      }
    ],
    "events": [
      {
        "on": "agent.status.changed"
      }
    ]
  },
  "capabilities": [
    {
      "kind": "notifications:show"
    },
    {
      "kind": "storage:own"
    },
    {
      "kind": "workspace:read"
    },
    {
      "kind": "workspace:write"
    },
    {
      "kind": "agent:read"
    }
  ]
}
