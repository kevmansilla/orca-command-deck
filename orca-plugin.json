{
  "manifestVersion": 2,
  "id": "command-deck",
  "name": "Command Deck",
  "version": "0.5.0",
  "description": "Tus agentes, bots, repos y tickets de Jira en un solo panel: quién te espera, quién trabaja, el Source Control de todos los repos de Orca y tus tickets.",
  "engines": {
    "orca": ">=1.4.259"
  },
  "execution": "trusted-worker",
  "pluginApi": 1,
  "main": "main.mjs",
  "contributes": {
    "panels": [
      {
        "id": "command-deck",
        "title": "Command Deck",
        "icon": "layers",
        "entry": "index.html",
        "ui": "html"
      }
    ],
    "events": [
      {
        "on": "agent.status.changed"
      }
    ],
    "commands": [
      {
        "id": "avisos.abrir",
        "title": "Command Deck: ir al último aviso"
      }
    ],
    "statusBarItems": [
      {
        "id": "avisos",
        "icon": "bell",
        "text": "",
        "tooltip": "Command Deck: sin avisos nuevos",
        "command": "avisos.abrir"
      }
    ]
  },
  "capabilities": [
    {
      "kind": "notifications:show"
    },
    {
      "kind": "storage:own"
    },
    {
      "kind": "workspace:read"
    },
    {
      "kind": "workspace:write"
    },
    {
      "kind": "agent:read"
    },
    {
      "kind": "workspace:create"
    },
    {
      "kind": "agent:launch"
    }
  ]
}
