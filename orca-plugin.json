{
  "manifestVersion": 2,
  "id": "multi-repo-git",
  "name": "Multi Repo Git",
  "version": "0.3.0",
  "description": "Source Control de todos los repos de Orca y un tablero de quién te espera, quién trabaja y tus bots. Abrilo desde su ícono en la barra lateral.",
  "engines": {
    "orca": ">=1.4.259"
  },
  "execution": "trusted-worker",
  "pluginApi": 1,
  "main": "main.mjs",
  "contributes": {
    "panels": [
      {
        "id": "source-control",
        "title": "Multi Repo Git",
        "icon": "layers",
        "entry": "index.html",
        "ui": "html"
      }
    ],
    "events": [
      {
        "on": "agent.status.changed"
      }
    ]
  },
  "capabilities": [
    {
      "kind": "notifications:show"
    },
    {
      "kind": "storage:own"
    },
    {
      "kind": "workspace:read"
    },
    {
      "kind": "workspace:write"
    },
    {
      "kind": "agent:read"
    }
  ]
}
