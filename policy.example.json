{
  "exclude": [
    "carpeta-que-no-quiero-ver"
  ],
  "standingBranches": [
    "agente-diagnostico"
  ],
  "rules": [
    {
      "path": "~/proyectos/personal",
      "free": true
    },
    {
      "under": "~/trabajo",
      "protected": [
        "main",
        "release"
      ],
      "base": "develop"
    },
    {
      "under": "~/cliente",
      "bases": "~/cliente/bases.json"
    }
  ],
  "commands": [
    {
      "label": "Mergear",
      "run": "git mi-merge",
      "warn": true
    },
    {
      "label": "Continuar merge",
      "run": "git mi-merge --continue",
      "when": "merging"
    }
  ],
  "tickets": [
    {
      "under": "~/trabajo",
      "dir": "~/trabajo/tickets"
    }
  ],
  "scan": {
    "under": "~/trabajo",
    "run": "~/bin/mi-scanner"
  },
  "worktrees": {
    "under": "~/trabajo",
    "create": "git mi-worktree {repo} {branch}",
    "remove": "git mi-worktree -d {repo} {branch}"
  },
  "jira": {
    "site": "https://mi-empresa.atlassian.net",
    "project": "ABC",
    "credentials": "~/.config/jira/credenciales.env",
    "tickets": "~/trabajo/tickets",
    "startPrompt": "Arrancamos {key}: {title}. Leé el ticket en Jira: {url}"
  }
}
